// Copy to Config.xcconfig and fill in. Config.xcconfig is gitignored.
//
// There is deliberately no backend URL and no API key here any more: a camera
// learns which club it belongs to by pairing, not by being rebuilt. That is
// what lets one build serve every club.

// Bundle identifier prefix, e.g. com.myclub
COURTSIDE_BUNDLE_PREFIX = com.example

// Optional: a public website shown in the app's health indicator. Leave empty
// unless you are building for one specific club.
COURTSIDE_SITE_URL =
