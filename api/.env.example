# ─────────────────────────────────────────────────────────────────────────────
# Courtside — backend configuration
#
# Copy to .env and fill in. The server refuses to start if a required value is
# missing, rather than falling back to a shared default.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8000

# ── Secrets (generate these — never reuse someone else's) ────────────────────
# Shared secret the camera app authenticates with.
#   openssl rand -hex 24
API_KEY=
# Either a one-time setup code — the club then chooses its PINs at first visit
# and they are kept in storage — or the PINs directly.  Not both.
#   openssl rand -hex 4
SETUP_CODE=
# Admin PIN for the website's admin view. Required unless SETUP_CODE is set.
ADMIN_PIN=
# Viewer PIN. 4–8 digits. Leave empty for open access — anyone with the link
# can then watch, which is rarely what you want for youth sport.
VIEWER_PIN=

# ── Open Source Cloud ────────────────────────────────────────────────────────
# Personal Access Token from app.osaas.io
OSC_ACCESS_TOKEN=
# Your OSC tenant name, e.g. "myclub"
OSC_TENANT=
# Name of the Restreamer instance this backend starts on demand.
OSC_INSTANCE_NAME=restreamer
# OSC region suffix: "prod" or "prod-se"
OSC_REGION=prod
# Optional: full Restreamer URL, overriding the derived one.
# RESTREAMER_URL=
# Prefix for this installation's Restreamer process IDs.
PROCESS_PREFIX=cs-
# How long Restreamer stays up after the last stream ends (ms). Default 1 hour.
# RESTREAMER_GRACE_PERIOD_MS=3600000

# ── Object storage (MinIO / S3) ──────────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_BUCKET=recordings
# Used for the storage gauge in the admin view.
MINIO_STORAGE_CAPACITY_GB=50

# ── Public web ───────────────────────────────────────────────────────────────
# Public origin of the website. Share links and social previews need it.
PUBLIC_SITE_URL=
# Extra allowed CORS origins, comma-separated. PUBLIC_SITE_URL and localhost
# are always allowed.
CORS_ORIGINS=

# ── Club identity (served publicly over GET /api/club) ───────────────────────
# The website reads these at runtime and themes itself, so one prebuilt bundle
# works for any club.
CLUB_NAME=Courtside
# Defaults to CLUB_NAME. Used as the home team on new recordings.
CLUB_SHORT_NAME=
CLUB_VENUE=
CLUB_ACCENT_COLOR="#C8A43F"
# Leave empty to use the placeholder shipped with the website.
CLUB_LOGO_URL=
CLUB_TAGLINE=
CLUB_DEFAULT_OPPONENT=Motståndare
