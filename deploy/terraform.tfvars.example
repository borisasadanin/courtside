# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Personal Access Token from app.osaas.io. The backend also uses it to start
# Restreamer on demand, so it is stored in the parameter store.
osc_pat = ""

# "prod" or "prod-se"
osc_environment = "prod"

# Names the resources. Lowercase letters and digits, 3-21 characters.
club_name = "myclub"

# What the website calls itself.
club_display_name = "My Club Courtside"
club_short_name   = "My Club IF"
club_venue        = "Myclubhallen"
club_accent_color = "#C8A43F"

# A name of your own for the site. Needs the PROFESSIONAL plan. Leave unset to
# use the app's generated <hash>.apps.osaas.io address.
# site_hostname = "myclub.apps.osaas.io"

# The Courtside repository, built from its root (backend + website).
api_git_url = "https://github.com/myclub/courtside.git"
api_git_ref = "main"
# Only for a private repository:
# api_git_token = ""

# Leave these unset. api_key is generated; the PINs are chosen by the club at
# first visit, with the code from `tofu output -raw setup_code`.
# api_key    = ""
# admin_pin  = ""
# viewer_pin = ""
